{
  "name": "punchpoint-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "start": "node server/src/server.js",
    "start:server": "node server/src/server.js",
    "start:client": "node client/.output/server/index.mjs",
    "client:dev": "npm --prefix client dev",
    "client:build": "npm --prefix client run build",
    "client:start": "node client/.output/server/index.mjs",
    "client:lint": "npm --prefix client run lint",
    "client:test": "npm --prefix client test",
    "server:dev": "npm --prefix server dev",
    "server:start": "node server/src/server.js",
    "server:seed": "node server/src/seed/seed.js",
    "server:test": "npm --prefix server test",
    "build": "npm --prefix client run build && node -e \"const fs = require('fs'); if (fs.existsSync('client/.vercel/output')) fs.cpSync('client/.vercel/output', '.vercel/output', {recursive: true});\"",
    "seed": "node server/src/seed/seed.js",
    "test": "npm --prefix client test && npm --prefix server test"
  },
  "optionalDependencies": {
    "lightningcss-linux-x64-gnu": ">=1.30.0",
    "lightningcss-win32-x64-msvc": ">=1.30.0",
    "@tailwindcss/oxide-linux-x64-gnu": ">=4.0.0",
    "@tailwindcss/oxide-win32-x64-msvc": ">=4.0.0"
  }
}
